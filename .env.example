APP_NAME="PPID Poltekkes Kemenkes Banten"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production stabil: LOG_LEVEL=error

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ppid_poltekkesbanten
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Akun super-admin (dipakai AdminUserSeeder) — password hanya di .env lokal/server
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Admin PPID production (dipakai PpidAdminSeeder / ppid:ensure-admin)
# Isi hanya di .env server — jangan commit password
PPID_ADMIN_EMAIL=
PPID_ADMIN_USERNAME=
PPID_ADMIN_PASSWORD=
PPID_ADMIN_NAME=Admin PPID

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Shared hosting: opsional bila public disk dipisah dari public_html
# PUBLIC_DISK_ROOT=
# PUBLIC_ASSET_URL=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="ppid@poltekkesbanten.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Form permohonan informasi publik
# Production:
# PPID_INFORMATION_REQUEST_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSffivoxDcFT-iDrc8eb1GKvkqhx-LenWuaQkE826D5uSbOG3A/viewform
PPID_INFORMATION_REQUEST_FORM_URL=

# Google Form pengajuan keberatan
# Production:
# PPID_OBJECTION_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLScE8lH-ihPiy_FbzWJ6zQIk8eiFgd9bUeckJerQPsNHNIMbew/viewform
PPID_OBJECTION_FORM_URL=
